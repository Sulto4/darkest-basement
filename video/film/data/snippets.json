 "cc_safe": {
  "file": "Assets/_Game/Scripts/Combat/CombatController.cs",
  "start": 389,
  "lines": [
   {
    "n": 389,
    "s": "static IEnumerator Safe(IEnumerator routine)"
   },
   {
    "n": 390,
    "s": "{"
   },
   {
    "n": 391,
    "s": "    while (routine != null)"
   },
   {
    "n": 392,
    "s": "    {"
   },
   {
    "n": 393,
    "s": "        object current;"
   },
   {
    "n": 394,
    "s": "        try"
   },
   {
    "n": 395,
    "s": "        {"
   },
   {
    "n": 396,
    "s": "            if (!routine.MoveNext()) yield break;"
   },
   {
    "n": 397,
    "s": "            current = routine.Current;"
   },
   {
    "n": 398,
    "s": "        }"
   },
   {
    "n": 399,
    "s": "        catch (Exception e)"
   },
   {
    "n": 400,
    "s": "        {"
   },
   {
    "n": 401,
    "s": "            Debug.LogException(e);"
   },
   {
    "n": 402,
    "s": "            yield break;"
   },
   {
    "n": 403,
    "s": "        }"
   },
   {
    "n": 404,
    "s": "        yield return current is IEnumerator nested ? Safe(nested) : current;"
   },
   {
    "n": 405,
    "s": "    }"
   },
   {
    "n": 406,
    "s": "}"
   }
  ]
 },
 "cc_juice": {
  "file": "Assets/_Game/Scripts/Combat/CombatController.cs",
  "start": 610,
  "lines": [
   {
    "n": 610,
    "s": "// Juice: hit-stop (60–100 ms, 150 ms la crit/kill), shake (trauma),"
   },
   {
    "n": null,
    "s": "    punch-in, flash."
   },
   {
    "n": 611,
    "s": "float severity = Mathf.Clamp01(e.RawAmount / 12f);"
   },
   {
    "n": 612,
    "s": "float stop = dot ? 0.04f : (e.Crit || lethal) ? 0.15f : Mathf.Lerp(0.06f,"
   },
   {
    "n": null,
    "s": "    0.1f, severity);"
   },
   {
    "n": 613,
    "s": "if (e.Amount > 0 || !dot) HitStop.Freeze(stop);"
   },
   {
    "n": 614,
    "s": "float trauma = dot ? 0.08f : 0.14f + 0.22f * severity + (e.Crit ? 0.25f :"
   },
   {
    "n": null,
    "s": "    0f) + (lethal ? 0.1f : 0f);"
   },
   {
    "n": 615,
    "s": "if (ctx != null && ctx.Hits == 1 && !dot) trauma += ctx.Style.Shake;"
   },
   {
    "n": 616,
    "s": "ScreenShake.Add(trauma);"
   }
  ]
 },
